							<video controls preload="metadata" playsinline muted>
								<source src="https://assets.cdn.filesafe.space/LnGkjnxS9ryXNCNUzgwt/media/69efc845d65f43b68cf61279.mp4" type="video/mp4" />
								Tu navegador no soporta el video.
							</video>
						</div>
					</div>
					<a href="#formulario" class="btn btn-orange btn-xl">QUIERO PREPARAR A MI HIJO →</a>
				</div>
			</div>
		</section>

		<!-- ===== 6. CIERRE + FORMULARIO (repetido) ===== -->
