				.footer-content { flex-direction: column; text-align: center; }
				.carousel-item { width: 220px; padding: 16px; }
				.carousel-item img { height: 160px; }
				.kit-answer-card { padding: 40px 24px 36px; }
				.kit-answer-list li { font-size: 0.95rem; }
				.kit-answer-cta { font-size: 1rem; padding: 18px 32px; }
				.foryou-mega-icon { font-size: 3.2rem; }
				.foryou-verdict { font-size: 1.35rem; }
				.sparkle { display: none; }
				.science-pro-grid { grid-template-columns: 1fr; gap: 32px; padding: 32px 24px 24px; }
				.science-pro-photo { max-width: 320px; margin: 0 auto; }
				.science-pro-stats { grid-template-columns: repeat(2, 1fr); padding: 24px; }
				.science-pro-stat { border-right: none; border-bottom: 1px solid var(--gray-200); padding: 14px 8px; }
				.science-pro-stat:nth-child(odd) { border-right: 1px solid var(--gray-200); }
				.science-pro-stat:nth-last-child(-n+2) { border-bottom: none; }
				.science-pro-stat:last-child:nth-child(odd) { grid-column: span 2; border-right: none; }
				.science-pro-stat-num { font-size: 1.6rem; }
			}

			@media (max-width: 600px) {
				.video-testimonials-real { grid-template-columns: 1fr; gap: 16px; }
			}
		</style>
