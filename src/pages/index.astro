			@keyframes sparkleFloat { 0%, 100% { transform: scale(1) rotate(0deg); opacity: 0.9; } 50% { transform: scale(1.3) rotate(180deg); opacity: 1; } }
			.foryou-no { border: 2px solid var(--gray-200); opacity: 0.78; background: var(--gray-50); }
