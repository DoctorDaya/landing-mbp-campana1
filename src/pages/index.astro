			.foryou-verdict-sub { font-size: 0.95rem; font-weight: 600; opacity: 0.85; position: relative; z-index: 2; }
			.foryou-card-body { padding: 28px 28px 36px; }
			.foryou-checks { list-style: none; padding: 0; margin: 0; }
			.foryou-checks li { display: flex; align-items: flex-start; gap: 14px; padding: 14px 12px; margin: 0 -12px; font-size: 1rem; line-height: 1.5; border-radius: 12px; transition: all 0.25s ease; }
			.foryou-checks li:not(:last-child) { border-bottom: 1px solid var(--gray-100); }
			.foryou-checks li strong { font-weight: 800; }
			.check-circle { display: inline-flex; align-items: center; justify-content: center; width: 32px; height: 32px; border-radius: 50%; font-weight: 900; font-size: 1rem; flex-shrink: 0; margin-top: 0; transition: transform 0.25s ease; }
			.foryou-yes { border: 3px solid var(--green); box-shadow: 0 16px 50px rgba(16, 185, 129, 0.25); animation: yesFloat 4s ease-in-out infinite, yesGlow 3s ease-in-out infinite; }
			@keyframes yesFloat { 0%, 100% { transform: translateY(0); } 50% { transform: translateY(-8px); } }
			@keyframes yesGlow { 0%, 100% { box-shadow: 0 16px 50px rgba(16, 185, 129, 0.25); } 50% { box-shadow: 0 20px 60px rgba(16, 185, 129, 0.5); } }
			.foryou-yes:hover { transform: translateY(-12px) scale(1.02); animation-play-state: paused; }
			.foryou-header-yes { background: linear-gradient(135deg, #10B981 0%, #06B6D4 100%); color: var(--white); }
			.foryou-shine { content: ''; position: absolute; top: 0; left: -75%; width: 50%; height: 100%; background: linear-gradient(100deg, transparent 0%, rgba(255,255,255,0) 40%, rgba(255,255,255,0.4) 50%, rgba(255,255,255,0) 60%, transparent 100%); transform: skewX(-15deg); animation: cardShine 4s ease-in-out infinite; pointer-events: none; z-index: 1; }
			.foryou-mega-yes { animation: iconBounce 2s ease-in-out infinite; }
			@keyframes iconBounce { 0%, 100% { transform: translateY(0) scale(1); } 50% { transform: translateY(-8px) scale(1.1); } }
			.foryou-header-yes .foryou-verdict { color: var(--white); }
			.foryou-header-yes .foryou-verdict-sub { color: rgba(255,255,255,0.92); }
			.check-yes { background: var(--green); color: var(--white); box-shadow: 0 4px 12px rgba(16, 185, 129, 0.4); }
			.foryou-yes .foryou-checks li:hover { background: rgba(16, 185, 129, 0.08); transform: translateX(6px); }
			.foryou-yes .foryou-checks li:hover .check-yes { transform: scale(1.2) rotate(15deg); }
			.foryou-yes .foryou-checks li strong { color: var(--green); }
			.sparkle { position: absolute; font-size: 1.6rem; z-index: 5; animation: sparkleFloat 3s ease-in-out infinite; pointer-events: none; }
			.sparkle-1 { top: -10px; left: -10px; animation-delay: 0s; }
