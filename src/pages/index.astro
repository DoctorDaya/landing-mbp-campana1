							</video>
						</div>
						<div class="video-vertical">
							<video controls preload="metadata" playsinline muted>
								<source src="https://assets.cdn.filesafe.space/LnGkjnxS9ryXNCNUzgwt/media/69efc82c05d41990011a4a47.mp4" type="video/mp4" />
