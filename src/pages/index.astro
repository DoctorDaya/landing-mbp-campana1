			.section-cta { background: linear-gradient(135deg,var(--purple),var(--pink)); padding: 90px 0; }
			.cta-card { background: var(--purple-dark); padding: 48px 40px; border-radius: var(--radius-xl); color: var(--white); position: relative; overflow: hidden; box-shadow: 0 30px 60px rgba(0,0,0,0.2); }
