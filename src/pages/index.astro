				flex-shrink: 0;
			}
			.hero-nino {
				width: 270px !important;
				max-width: 270px;
				height: auto !important;
				display: block;
				filter: drop-shadow(0 12px 28px rgba(0,0,0,0.2));
				pointer-events: none;
			}
			.hero-text {
				display: flex;
				flex-direction: column;
				align-items: flex-start;
				text-align: left;
			}
			.hero-logo { margin-bottom: 44px; }
			.hero-logo img { height: 84px; }
			.hero-title {
