				<div class="form-left">
					<h2 class="form-title">
						La ventana de oportunidad <br/>se cierra a los 6 años...
					</h2>
					<div class="form-subtitle">Su futuro empieza hoy.</div>
					<p class="form-text">
						La mayoría de los padres no saben que el cerebro de su bebé está en su máximo potencial para absorber nuevos conocimientos en esta etapa. <strong>¡Aprovecha esta ventana de oro antes de que se cierre!</strong>
					</p>
				</div>
				<div class="form-right">
					<form class="form-card" onsubmit="handleSubmit(event)">
						<input type="text" name="nombre" placeholder="Nombre" required />
						<input type="tel" name="telefono" placeholder="Teléfono" required />
						<input type="text" name="ciudad" placeholder="Ciudad" required />
						<input type="email" name="email" placeholder="Email" required />
						<button type="submit" class="btn-form">ENVIAR</button>
					</form>
				</div>
			</div>
		</section>

		<!-- FOOTER -->
		<footer class="footer">
			<div class="container">
				<div class="footer-content">
					<div><div class="logo logo-light"><img src="/logo.png" alt="Bebé Políglota" /></div><p class="footer-tagline">La cuna de nuevos idiomas.</p></div>
					<div class="footer-info">
						<p>© 2026 Bebé Políglota · Colombia</p>
						<p>📞 +57 300 920 9034</p>
					</div>
				</div>
			</div>
		</footer>

		<!-- WHATSAPP FLOAT -->
		<a href={`https://wa.me/${whatsappNumber}`} class="whatsapp-float" target="_blank" rel="noopener" aria-label="WhatsApp"><span>💬</span></a>

		<script is:inline>
			function handleSubmit(event) {
				event.preventDefault();
				const formData = new FormData(event.target);
				alert(`¡Listo ${formData.get('nombre')}! Te llamamos pronto.`);
				event.target.reset();
			}
		</script>

		<style is:global>
			* { box-sizing: border-box; margin: 0; padding: 0; }
			:root {
				--purple: #7C3AED; --purple-dark: #5B21B6; --purple-light: #A78BFA; --purple-soft: #F3E8FF;
				--pink: #EC4899; --pink-dark: #BE185D; --pink-light: #F9A8D4; --pink-soft: #FCE7F3;
				--cyan: #06B6D4; --cyan-light: #67E8F9; --cyan-soft: #CFFAFE;
				--yellow: #FBBF24; --yellow-light: #FDE68A;
				--green: #10B981; --green-light: #6EE7B7;
				--orange: #F97316; --orange-light: #FB923C;
				--sky-soft: #E0F2FE; --sky-medium: #BAE6FD; --sky-light: #F0F9FF;
				--text-dark: #1E1B4B; --text-medium: #4B5563; --text-light: #6B7280;
				--white: #FFFFFF; --gray-50: #F9FAFB; --gray-100: #F3F4F6; --gray-200: #E5E7EB;
				--font-display: 'Nunito', sans-serif; --font-body: 'Quicksand', sans-serif;
				--radius: 16px; --radius-lg: 24px; --radius-xl: 32px; --radius-2xl: 48px;
				--shadow: 0 4px 20px rgba(124, 58, 237, 0.08);
				--shadow-lg: 0 12px 40px rgba(124, 58, 237, 0.15);
			}
			html { scroll-behavior: smooth; }
			body { font-family: var(--font-body); color: var(--text-dark); line-height: 1.65; -webkit-font-smoothing: antialiased; overflow-x: hidden; background: var(--white); }
			.container { max-width: 1200px; margin: 0 auto; padding: 0 24px; }

			h1, h2, h3, h4 { font-family: var(--font-display); font-weight: 800; color: var(--text-dark); line-height: 1.2; }
			.text-purple { color: var(--purple); }
			.text-pink { color: var(--pink); }
			.text-cyan { color: var(--cyan); }

			/* BOTONES */
			.btn { display: inline-flex; align-items: center; justify-content: center; padding: 16px 36px; border-radius: 100px; font-weight: 800; text-decoration: none; transition: all 0.25s; border: none; cursor: pointer; font-family: var(--font-body); font-size: 1rem; }
			.btn-orange { background: var(--orange); color: var(--white); box-shadow: 0 8px 24px rgba(249, 115, 22, 0.35); }
			.btn-orange:hover { background: #EA580C; transform: translateY(-2px); }
			.btn-xl { padding: 18px 44px; font-size: 1.1rem; }

			/* TOPBAR */
			.topbar { background: var(--pink); color: var(--white); text-align: center; padding: 12px 0; font-weight: 600; font-size: 0.9rem; }

			/* NUBES decorativas */
			.cloud { position: absolute; background: var(--white); border-radius: 50%; opacity: 0.85; pointer-events: none; }
			.cloud::before, .cloud::after { content: ''; position: absolute; background: var(--white); border-radius: 50%; }
			.cloud-1 { width: 80px; height: 50px; top: 15%; left: 8%; }
			.cloud-1::before { width: 50px; height: 50px; top: -20px; left: 10px; }
			.cloud-1::after { width: 40px; height: 40px; top: -15px; right: 10px; }
			.cloud-2 { width: 100px; height: 60px; top: 25%; right: 10%; }
			.cloud-2::before { width: 60px; height: 60px; top: -25px; left: 15px; }
			.cloud-2::after { width: 50px; height: 50px; top: -20px; right: 12px; }
			.cloud-3 { width: 70px; height: 40px; bottom: 20%; left: 15%; }
			.cloud-3::before { width: 45px; height: 45px; top: -18px; left: 8px; }
			.cloud-4 { width: 90px; height: 50px; bottom: 12%; right: 18%; }
			.cloud-4::before { width: 55px; height: 55px; top: -22px; left: 12px; }
			.cloud-4::after { width: 40px; height: 40px; top: -15px; right: 8px; }
			.cloud-5 { width: 80px; height: 45px; top: 10%; left: 5%; }
			.cloud-5::before { width: 50px; height: 50px; top: -20px; left: 10px; }
			.cloud-6 { width: 70px; height: 40px; top: 60%; right: 8%; }
			.cloud-6::before { width: 45px; height: 45px; top: -18px; left: 8px; }

			/* HERO */
			.hero {
				background: linear-gradient(180deg, var(--sky-medium) 0%, var(--sky-soft) 100%);
				padding: 60px 0 80px;
				position: relative;
				overflow: hidden;
				min-height: 600px;
			}
			.hero-grid {
				display: grid;
				grid-template-columns: 1.1fr 1fr;
				gap: 60px;
				align-items: center;
				position: relative;
				z-index: 2;
			}
			.hero-logo { margin-bottom: 24px; }
			.hero-logo img { height: 80px; }
			.hero-title {
				font-family: var(--font-display);
				font-size: clamp(1.4rem, 2.6vw, 2rem);
				font-weight: 700;
				color: var(--purple-dark);
				line-height: 1.3;
				margin-bottom: 28px;
				max-width: 540px;
			}
			.hero-title strong { font-weight: 900; color: var(--purple-dark); }
			.hero-subtitle {
				font-size: 1.3rem;
				color: var(--text-dark);
				margin-bottom: 28px;
				font-weight: 600;
				line-height: 1.4;
			}
			.hero-subtitle strong { font-size: 1.6rem; font-weight: 900; }
			.hero-badge {
				display: inline-block;
				background: var(--cyan-light);
				color: var(--purple-dark);
				padding: 18px 36px;
				border-radius: 100px;
				font-weight: 800;
				font-size: 1.1rem;
				text-align: center;
				line-height: 1.3;
				box-shadow: 0 4px 16px rgba(6, 182, 212, 0.3);
			}
			.hero-image {
				position: relative;
				display: flex;
				justify-content: center;
				align-items: center;
			}
			.hero-image-circle {
				width: 100%;
				max-width: 460px;
				aspect-ratio: 1;
				background: radial-gradient(circle, #A7F3D0 30%, #6EE7B7 70%, #34D399 100%);
				border-radius: 50%;
				display: flex;
				align-items: center;
				justify-content: center;
				position: relative;
				box-shadow: 0 20px 60px rgba(16, 185, 129, 0.25);
			}
			.hero-image-circle img {
				width: 88%;
				height: 88%;
				object-fit: contain;
				filter: drop-shadow(0 12px 24px rgba(0,0,0,0.15));
			}

			/* VIDEO SECTION */
			.section-video {
				padding: 80px 0;
				background: var(--white);
				position: relative;
			}
			.video-grid {
				display: grid;
				grid-template-columns: 360px 1fr;
				gap: 70px;
				align-items: center;
				max-width: 1000px;
				margin: 0 auto;
			}
			.video-vertical {
				background: #000;
				border-radius: var(--radius-lg);
				overflow: hidden;
				aspect-ratio: 9/16;
				box-shadow: 0 20px 50px rgba(0,0,0,0.18);
				border: 4px solid var(--white);
			}
			.video-vertical video {
				width: 100%;
				height: 100%;
				object-fit: cover;
				display: block;
			}
			.video-text {
				position: relative;
			}
			.video-decoration {
				position: absolute;
				top: -40px;
				left: -40px;
				width: 80px;
				height: 80px;
				background: var(--green-light);
				border-radius: 50%;
				opacity: 0.6;
				z-index: 0;
			}
			.video-lead {
				font-size: 1.15rem;
				color: var(--text-dark);
				margin-bottom: 24px;
				line-height: 1.55;
				position: relative;
				z-index: 1;
			}
			.video-lead strong { font-weight: 800; color: var(--purple-dark); }
			.video-highlight {
				font-family: var(--font-display);
				font-size: 1.3rem;
				font-weight: 800;
				color: var(--purple-dark);
				margin-bottom: 28px;
				line-height: 1.3;
				position: relative;
				z-index: 1;
			}

			/* RESPALDO CIENTÍFICO */
			.section-respaldo {
				padding: 80px 0;
				background: var(--pink-soft);
			}
			.respaldo-grid {
				display: grid;
				grid-template-columns: 1fr 1.2fr;
				gap: 60px;
				align-items: center;
				max-width: 1050px;
				margin: 0 auto;
			}
			.respaldo-image {
				position: relative;
				display: flex;
				justify-content: center;
			}
			.respaldo-image-bg {
				position: absolute;
				inset: -20px;
				background: radial-gradient(circle, var(--pink-light) 0%, transparent 70%);
				border-radius: 50%;
				z-index: 0;
			}
			.respaldo-image img {
				width: 100%;
				max-width: 320px;
				aspect-ratio: 1;
				object-fit: cover;
				border-radius: 50%;
				border: 8px solid var(--white);
				box-shadow: 0 20px 50px rgba(236, 72, 153, 0.25);
				position: relative;
				z-index: 1;
			}
			.respaldo-content {
				background: var(--white);
				padding: 36px 36px 32px;
				border-radius: var(--radius-xl);
				box-shadow: 0 16px 40px rgba(236, 72, 153, 0.15);
				position: relative;
			}
			.respaldo-badge-icon {
				position: absolute;
