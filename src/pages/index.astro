			}
			.footer-brand { display: flex; align-items: center; gap: 14px; }
			.footer-logo { height: 36px; width: auto; filter: brightness(0) invert(1); }
			.footer-tagline { font-size: 0.95rem; color: rgba(255,255,255,0.8); font-weight: 600; }
			.footer-info { text-align: right; font-size: 0.9rem; color: rgba(255,255,255,0.75); }
			.footer-info a { color: var(--cyan-light); text-decoration: none; }
