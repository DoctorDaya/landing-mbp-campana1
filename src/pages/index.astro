			.science-pro-deco-2 { position: absolute; bottom: -100px; left: -100px; width: 300px; height: 300px; background: radial-gradient(circle, rgba(236,72,153,0.08) 0%, transparent 70%); border-radius: 50%; pointer-events: none; }
			.science-pro-grid { display: grid; grid-template-columns: 380px 1fr; gap: 48px; padding: 48px 48px 36px; position: relative; z-index: 1; }
