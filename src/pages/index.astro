			.disclaimer { background: var(--gray-50); padding: 32px 0; border-top: 1px solid var(--gray-200); border-bottom: 1px solid var(--gray-200); }
			.disclaimer p { color: var(--text-light); font-size: 0.85rem; text-align: center; }
			.footer { background: var(--text-dark); color: var(--white); padding: 48px 0; }
			.footer-content { display: flex; justify-content: space-between; align-items: center; gap: 32px; flex-wrap: wrap; }
			.footer-tagline { color: rgba(255,255,255,0.6); margin-top: 12px; font-style: italic; }
			.footer-info { color: rgba(255,255,255,0.5); font-size: 0.88rem; }
			.whatsapp-float { position: fixed; bottom: 24px; right: 24px; width: 64px; height: 64px; background: #25D366; border-radius: 50%; display: flex; align-items: center; justify-content: center; font-size: 2rem; text-decoration: none; box-shadow: 0 8px 24px rgba(37,211,102,0.4); z-index: 50; }

			@media (max-width: 900px) {
